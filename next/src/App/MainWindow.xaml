<Window x:Class="NssmNext.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NSSM Next — 只读原型">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32" RowSpacing="20" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="NSSM" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="服务管理 · 原生一体化实验版" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" Content="刷新服务" VerticalAlignment="Center"/>
        </Grid>
        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational"
            Title="只读模式" Message="不安装、不修改、不启动或停止任何服务。现有命令入口保持原实现。"/>
        <Grid Grid.Row="2" ColumnSpacing="28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索服务名称或程序路径" TextChanged="Search_Changed" AutomationProperties.Name="搜索 NSSM 服务"/>
                <ListView x:Name="ServiceList" Grid.Row="1" SelectionChanged="Selection_Changed" SelectionMode="Single"/>
            </Grid>
            <StackPanel Grid.Column="1" Spacing="16">
                <TextBlock x:Name="DetailTitle" Text="选择一个服务" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText" Text="服务列表直接从原生核心查询，不调用外部 nssm.exe。" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>
                <TextBlock Text="兼容性优先" FontWeight="SemiBold"/>
                <TextBlock Text="这是独立原型，不会替换生产版本。编辑和控制入口需完成行为对照测试后再开放。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
