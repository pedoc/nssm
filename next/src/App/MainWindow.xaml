<Window x:Class="NssmNext.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NSSM Next — 服务管理">
    <Grid x:Name="RootPanel" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Padding="28" RowSpacing="16" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="NSSM Next" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="管理由 NssmNext 创建的服务" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Click="Refresh_Click" Content="刷新" AutomationProperties.Name="刷新服务"/>
                <Button x:Name="NewButton" Click="New_Click" Content="新增服务" AccessKey="N" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="ModeBar" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational">
            <InfoBar.ActionButton><Button x:Name="ElevateButton" Content="以管理员身份重新打开" Click="Elevate_Click"/></InfoBar.ActionButton>
        </InfoBar>
        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational"
            Title="NssmNext 服务" Message="正在读取服务列表…"/>
        <Grid Grid.Row="3" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索名称、描述或程序路径" TextChanged="Search_Changed" AutomationProperties.Name="搜索 NssmNext 服务"/>
                <ListView x:Name="ServiceList" Grid.Row="1" SelectionChanged="Selection_Changed" SelectionMode="Single"/>
                <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="320">
                    <TextBlock x:Name="EmptyTitle" Text="还没有 NssmNext 服务" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyMessage" Text="点击新增服务，选择要托管的程序。其他 Windows 和旧 NSSM 服务不会混入列表。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="EmptyNewButton" Click="New_Click" Content="新增第一个服务" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ListCount" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DetailTitle" Text="选择一个服务" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailStatus" Text="在此查看配置、编辑和控制服务。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartButton" Content="启动" Click="Start_Click" IsEnabled="False"/>
                            <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False"/>
                            <Button x:Name="RestartButton" Content="重启" Click="Restart_Click" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="EditButton" Content="编辑配置" Click="Edit_Click" AccessKey="E" IsEnabled="False"/>
                            <Button x:Name="DeleteButton" Content="删除服务…" Click="Delete_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DetailText" Text="新增、编辑和删除只会作用于带有 NssmNext 归属标识的服务。删除不会移除应用程序或日志文件。"
                            TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
